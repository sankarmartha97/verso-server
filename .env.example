NODE_ENV=development
PORT=3001 # 3000 taken by another local project
CORS_ORIGIN=http://localhost:5173
# local dev stack (docker-compose.yml) — real secrets belong in a secret manager, never here:
DATABASE_URL=postgres://verso:verso@localhost:5432/verso
REDIS_URL=redis://localhost:6380
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=verso
S3_KEY=verso
S3_SECRET=versosecret
SMTP_URL=smtp://localhost:1026
# MAIL_FROM=Verso <no-reply@verso.local>   # only Mailhog accepts this; real
#                                           #   providers need a sender they recognize

# --- Production (Render, two-service deploy: this server + the separately
# deployed verso-client static site) ---
# NODE_ENV=production            # flips the refresh cookie to secure+sameSite=none,
#                                 #   required once client and server are on different
#                                 #   *.onrender.com subdomains (different "sites")
# CORS_ORIGIN=https://<your-verso-client-service>.onrender.com   # exact origin, no
#                                 #   trailing slash — '*' + credentials:true is invalid
#                                 #   per the CORS spec and the cookie won't be sent
# DATABASE_URL=<from Render's managed Postgres>
# REDIS_URL=<from Render's managed Key Value (Redis)>
# JWT_ACCESS_SECRET=<real random value, e.g. `openssl rand -hex 32`>
# JWT_REFRESH_SECRET=<same, different value>
# S3_ENDPOINT=<your S3-compatible provider's endpoint, e.g. Cloudflare R2 or
#              Supabase Storage's S3 API — for Supabase this is the .../storage/v1/s3 URL>
# S3_REGION=<matters for real providers, unlike MinIO — a mismatch breaks
#            request signing even with correct credentials>
# S3_BUCKET / S3_KEY / S3_SECRET=<from that provider>
#   (the bucket also needs: CORS configured on the provider's side so the
#   browser can PUT to presigned upload URLs, and public read access enabled
#   — both are provider dashboard config, not something this app's code
#   controls. Confirmed working end-to-end against Supabase Storage this way.)
# S3_PUBLIC_URL_BASE=<only needed if the provider serves public GETs from a
#   different host/path than the S3 API endpoint above — Supabase does:
#   S3_ENDPOINT is .../storage/v1/s3, but public files are served from
#   https://<project-ref>.supabase.co/storage/v1/object/public instead.
#   Leave unset for providers like MinIO/R2 where the two are the same.
# SMTP_URL=<a real SMTP provider, e.g. smtp://resend:<api-key>@smtp.resend.com:587>
# MAIL_FROM=Verso <onboarding@resend.dev>   # or your own verified domain
