NODE_ENV=development
PORT=3001 # 3000 taken by another local project
CORS_ORIGIN=http://localhost:5173
# local dev stack (docker-compose.yml) — real secrets belong in a secret manager, never here:
DATABASE_URL=postgres://verso:verso@localhost:5432/verso
REDIS_URL=redis://localhost:6380
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=verso
S3_KEY=verso
S3_SECRET=versosecret
SMTP_URL=smtp://localhost:1026
